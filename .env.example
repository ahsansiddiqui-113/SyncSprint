# ---- Database -------------------------------------------------------------
# Any Postgres works (Neon / Supabase free tiers are fine):
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# For zero-setup local dev, use an embedded PGlite database on disk:
DATABASE_URL=pglite://./.pglite

# ---- Better Auth ------------------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-32+-char-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google OAuth (button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Microsoft (work/school or personal accounts). Redirect URI: <app>/api/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ---- Free-tier AI providers (all optional; tried in this order) -----------
# Without any key, every AI feature still works via deterministic fallbacks.
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Max AI calls per organization per UTC day (protects shared free quotas)
AI_DAILY_ORG_QUOTA=50

# ---- Server -----------------------------------------------------------------
PORT=3000
# Running several app servers? Relay realtime events between them via Postgres LISTEN/NOTIFY
# (needs a direct postgres:// connection, e.g. DATABASE_URL_UNPOOLED on Neon).
# REALTIME_FANOUT=postgres
# Local testing of webhooks against http://localhost receivers (never honoured in production):
# WEBHOOKS_ALLOW_PRIVATE=true

# ---- Platform owner (you, the vendor) -----------------------------------------
# Who can open /platform (all customers, billing actions). Safest: your user id.
# PLATFORM_ADMIN_USER_IDS=
# Or by email (in production only honoured for verified emails, e.g. Google sign-in):
# PLATFORM_ADMIN_EMAILS=you@yourcompany.com

# ---- Payments: Polar (polar.sh) ----------------------------------------------
# Use "sandbox" until you're ready to take real payments. Tokens are per environment.
# POLAR_SERVER=sandbox
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=whsec_...          (webhook URL: https://<your-domain>/api/billing/polar)
# Seat-based products (price per seat): Pay as you go $5/mo, Team $3.50/mo yearly (5-50), Business $3/mo yearly (51-100)
# POLAR_PRODUCT_PAYG=
# POLAR_PRODUCT_TEAM=
# POLAR_PRODUCT_BUSINESS=

# --- Scheduled automations (Phase 8) ---
# Long-running servers (npm run dev / start) run the scheduler every minute on their own.
# On Vercel, a daily cron calls /api/cron/automations with "Authorization: Bearer <CRON_SECRET>";
# active users also nudge it. Generate one with: openssl rand -hex 32
# CRON_SECRET=

# --- Phase 9: reaching people outside the app (all optional; without them messages go to the dev outbox) ---
# Email via Resend (https://resend.com): instant notification emails and daily/weekly digests.
# RESEND_API_KEY=
# EMAIL_FROM="SyncSprint <notifications@yourdomain.com>"
# Browser push (installable app). Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com
# WhatsApp Cloud API (Meta): an approved template with one body parameter.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=task_update
# WHATSAPP_TEMPLATE_LANG=en
# Email-to-task: point your provider's inbound webhook (Postmark/Resend/SendGrid/Mailgun) at
# <app>/api/inbound/email with "Authorization: Bearer <INBOUND_EMAIL_SECRET>".
# INBOUND_EMAIL_DOMAIN=in.yourdomain.com
# INBOUND_EMAIL_SECRET=
